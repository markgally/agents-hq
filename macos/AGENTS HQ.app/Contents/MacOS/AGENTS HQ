#!/bin/bash
set -euo pipefail
BIN_DIR="$(cd -P "$(dirname "$0")" && pwd)"
CONFIG="$BIN_DIR/../Resources/install.plist"
if [ -f "$CONFIG" ]; then
  ROOT=$(/usr/bin/plutil -extract ProjectRoot raw -o - "$CONFIG")
else
  ROOT="$(cd "$BIN_DIR/../../../.." && pwd)"
fi
error_dialog() {
  /usr/bin/osascript - "$1" <<'APPLESCRIPT'
on run argv
  display alert "AGENTS HQ" message (item 1 of argv) as critical
end run
APPLESCRIPT
}
if [ ! -f "$ROOT/macos/bootstrap.sh" ]; then
  error_dialog "The AGENTS HQ project folder was moved or removed. Run its Mac installer again from the new location."
  exit 1
fi
mkdir -p "$ROOT/.runtime"
if ! /bin/bash "$ROOT/macos/bootstrap.sh" >>"$ROOT/.runtime/mac-setup.log" 2>&1; then
  error_dialog "Private Python setup failed. See $ROOT/.runtime/mac-setup.log, then run the Mac installer again."
  exit 1
fi
PYTHON="$ROOT/.runtime/python/bin/python3"
if ! "$PYTHON" "$ROOT/macos/setup.py" ensure >>"$ROOT/.runtime/mac-setup.log" 2>&1; then
  error_dialog "Mac setup could not finish. See $ROOT/.runtime/mac-setup.log."
  exit 1
fi
case "${1:-}" in -psn_*) shift ;; esac
exec "$PYTHON" "$ROOT/macos/launcher.py" "$@"
